# Testnet faucet (BOT Chain testnet only). Use a dedicated wallet holding tBOT, never a mainnet key.
FAUCET_PRIVATE_KEY=
# tBOT sent per claim
FAUCET_AMOUNT=0.1
# Hours between claims for the same wallet or IP
FAUCET_COOLDOWN_HOURS=24
# Test USDT on BOT Chain testnet. Defaults to the token in lib/network.ts; set only to use another.
# The faucet wallet above must hold a supply of it, plus tBOT for gas.
# FAUCET_USDT_ADDRESS=
# USDT sent per claim, in whole tokens (decimals are read from the contract)
FAUCET_USDT_AMOUNT=25

# Production only, after faucet.uzolabs.xyz resolves: moves /faucet to the subdomain.
# NEXT_PUBLIC_FAUCET_SUBDOMAIN=true

# Optional backup for Search Console, which is verified by a DNS TXT record. Paste only the content value of the meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
